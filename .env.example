PORT=3000
SITE_URL=https://www.bsmplumbingservices.co.uk
CORS_ORIGINS=https://www.bsmplumbingservices.co.uk,https://bsmplumbingservices.co.uk

# Admin API key (long random string). Required to access /api/admin/*
ADMIN_API_KEY=change-me-to-a-long-random-string

# SMTP (notifications go to BUSINESS_EMAIL)
BUSINESS_EMAIL=info@bsmplumbingservices.co.uk
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@bsmplumbingservices.co.uk
SMTP_PASS=

# Business phone / address shown in schema.org data
BUSINESS_PHONE=
BUSINESS_ADDRESS_STREET=
BUSINESS_ADDRESS_CITY=
BUSINESS_ADDRESS_POSTCODE=
BUSINESS_LAT=
BUSINESS_LNG=

# Optional: live Google reviews via Places API (New)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Optional: Google Business Profile review link
GOOGLE_REVIEW_URL=
